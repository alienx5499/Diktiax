# Backend (backend/src/config.rs, agent/claude_planner.rs, agent/openai_planner.rs, actions/webhook.rs).
# All optional; the values below are the defaults except where noted.
# With a password (e.g. Railway): falkor://default:<password>@falkordb.railway.internal:6379
FALKORDB_URL=falkor://127.0.0.1:6379
FALKORDB_GRAPH=claimgraph
HOST=0.0.0.0
PORT=3001

# Leave empty to use the rule-based planner. Set a key to let Claude choose the graph tools.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Used only when ANTHROPIC_API_KEY is empty: free OpenAI-compatible planner (Groq by default).
# LLM_BASE_URL defaults to https://api.groq.com/openai/v1; set it for OpenRouter, Gemini or Ollama.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=

# Optional: escalated claims POST an evidence summary here. Empty = skipped.
WEBHOOK_URL=

# Frontend (frontend/src/lib/api.ts). Inlined at build time; must be reachable from the browser.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3001

# POST /api/seed (wipes the graph) fails closed: it needs header x-admin-token matching ADMIN_TOKEN,
# and is refused when ADMIN_TOKEN is empty unless DIKTIAX_DEV=1 (local only; `make run-backend` sets it).
ADMIN_TOKEN=
DIKTIAX_DEV=
